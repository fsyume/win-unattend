<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  iVentoy Windows 11 无人值守 answer file（UEFI / GPT）
  ============================================================================
  放置位置：<iVentoy 解压目录>\user\scripts\unattend.xml
  然后在 iVentoy 界面里：镜像管理 -> 选中 Win11 的 ISO
                      -> 自动安装脚本：新增本文件并设为默认
                      -> 脚本选择超时时间设为非 0 值

  【编码要求】本文件含中文注释，必须保存为 UTF-8 with BOM。
  不要另存为 ANSI / GBK，否则 Windows Setup 会报
  "Windows 无法分析或处理无人参与应答文件"。
  用 VS Code 打开时右下角应显示 "UTF-8 with BOM"。

  iVentoy 会对自动安装脚本里的 $$VT_xxx$$ 变量做替换。
  本文件用到的变量（已核对官方变量表）：
    $$VT_WINDOWS_DISK_CLOSEST_200$$  -> 容量最接近 200GB 的那块盘的 Windows 磁盘号。
                                        同一位置也可换成：
                                          _1ST_NONUSB   第一个非 USB 盘
                                          _MAX_SIZE     容量最大的盘
                                          _CLOSEST_<n>  最接近 n GB 的盘

  使用前必须修改的地方（在文件里搜索 "EDIT ME"）：
    1. /IMAGE/NAME          -> install.wim 里的准确版本名
                               （非英文版介质上是本地化的，见下方「本地化介质警告」）
    2. Administrator 密码（两处：AutoLogon 与 AdministratorPassword，必须完全一致）

  Windows 11 专属事项（这些不由此文件负责）：
    * TPM 2.0 / 安全启动 / 内存 / CPU 检查，由 iVentoy 界面上的
      "ByPass HW Check" 勾选框绕过（它在 WinPE 里写
      HKLM\SYSTEM\Setup\LabConfig\Bypass*Check 系列注册表值）。
      不走 iVentoy、或忘了勾这个框，在不满足硬件要求的机器上装 Win11
      会停在「这台电脑不满足运行 Windows 11 的要求」。
    * 跳过微软账户要求是 "ByPass NRO" 勾选框。本文件不依赖它：
      下面的本地账户是通过微软有文档支持的 UserAccounts 元素创建的，
      所以即使某些版本移除了 bypassnro，装机流程依然可用。
    * Windows 11 不接受安装到 MBR/Legacy，因此这里是 UEFI/GPT 布局。
  ============================================================================
-->
<unattend xmlns="urn:schemas-microsoft-com:unattend">

  <!-- ======================= 阶段 1：windowsPE ========================= -->
  <settings pass="windowsPE">

    <component name="Microsoft-Windows-International-Core-WinPE"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral"
               versionScope="nonSxS"
               xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
      <SetupUILanguage>
        <UILanguage>zh-CN</UILanguage>
      </SetupUILanguage>
      <InputLocale>0804:00000804</InputLocale>
      <SystemLocale>zh-CN</SystemLocale>
      <UILanguage>zh-CN</UILanguage>
      <UserLocale>zh-CN</UserLocale>
    </component>

    <!--
      这里故意没有 Microsoft-Windows-PnpCustomizationsWinPE 组件：
      本方案依赖 ISO 内 boot.wim 自带的网卡驱动，不使用 iVentoy 文件注入。

      如果某台机器停在「缺少计算机所需的介质驱动程序」，那个报错不是缺硬盘驱动，
      而是 boot.wim 里没有这台机器网卡的驱动，导致 iVentoy 无法通过网络把 ISO
      挂成本地盘，Setup 也就找不到安装源。
      补救办法：把该组件加回来（<Path>X:\drivers</Path>），并通过 iVentoy 的注入包
      把厂商网卡驱动送进去，详见 README.md 的「缺驱动的补救方案」一节。
    -->

    <component name="Microsoft-Windows-Setup"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral"
               versionScope="nonSxS"
               xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
      <DiskConfiguration>
        <Disk wcm:action="add">
          <CreatePartitions>
            <CreatePartition wcm:action="add">
              <Order>1</Order>
              <Size>300</Size>
              <Type>EFI</Type>
            </CreatePartition>
            <CreatePartition wcm:action="add">
              <Order>2</Order>
              <Size>16</Size>
              <Type>MSR</Type>
            </CreatePartition>
            <CreatePartition wcm:action="add">
              <Order>3</Order>
              <Extend>true</Extend>
              <Type>Primary</Type>
            </CreatePartition>
          </CreatePartitions>
          <ModifyPartitions>
            <!-- 分区 1：EFI 系统分区，必须是 FAT32 -->
            <ModifyPartition wcm:action="add">
              <Order>1</Order>
              <PartitionID>1</PartitionID>
              <Label>System</Label>
              <Format>FAT32</Format>
            </ModifyPartition>
            <!--
              分区 2（MSR）故意不在这里修改或格式化，
              把它写进来是导致 Setup 失败的常见原因。
              分区 3 才是系统所在卷。
            -->
            <ModifyPartition wcm:action="add">
              <Order>2</Order>
              <PartitionID>3</PartitionID>
              <Label>Windows</Label>
              <Letter>C</Letter>
              <Format>NTFS</Format>
            </ModifyPartition>
          </ModifyPartitions>
          <!--
            ★★★ 会清空数据 ★★★
            目标盘 = 容量最接近 200GB 的那块盘。

            为什么不写死 0：多控制器机器上的枚举顺序和你想的不一样，
            写死 0 很可能擦错盘。

            为什么用「最接近 N」而不是「第一个非 USB 盘」：它按容量这种
            不随固件和控制器变化的属性来选，同一份 answer file 可以通用于
            混装机型。

            注意：_CLOSEST_ / _MAX_SIZE 只按容量排序，不像 _1ST_NONUSB 那样
            排除 USB 盘。插着的大容量 U 盘或移动固态可能在比较中胜出，
            然后被擦掉。装机前务必拔掉所有可移动存储。

            比较的是 Windows 报出来的容量，单位是 GiB 但显示成 GB：
            标称 200GB 的盘显示约 186GB，标称 256GB 的约 238GB。
            填 200 仍然能正确区分（|186-200| = 14 比 |238-200| = 38 更近）。

            在第一台真机上务必确认实际数值：在安装界面按 Shift+F10 调出 cmd，执行
                diskpart
                list disk
                exit
            即可看到每块盘的准确 GB 数和磁盘号，据此把 _CLOSEST_XXX 调到你要的值。
          -->
          <DiskID>$$VT_WINDOWS_DISK_CLOSEST_200$$</DiskID>
          <WillWipeDisk>true</WillWipeDisk>
        </Disk>
        <WillShowUI>OnError</WillShowUI>
      </DiskConfiguration>

      <!--
        可选方案：独立的 1GB WinRE 恢复分区，使用 GPT 恢复分区类型 GUID。
        Windows 11 25H2/26H2 会把恢复分区切到约 500MB，之后累积更新会以
        0x80070643 失败。这个布局一开始就给它 1000MB。
        注意排序规则：使用 <Extend>true</Extend> 的分区必须最后创建，
        这就是为什么这里 Recovery 是分区 1，而不是分区 4。

        要启用的话，把上面整个 <DiskConfiguration> 块替换成下面这块，
        并把下面 <InstallTo> 里的 <PartitionID> 从 3 改成 4。

        <DiskConfiguration>
          <Disk wcm:action="add">
            <CreatePartitions>
              ; 分区 1：WinRE 恢复分区，1000MB
              <CreatePartition wcm:action="add">
                <Order>1</Order>
                <Size>1000</Size>
                <Type>Primary</Type>
              </CreatePartition>
              ; 分区 2：EFI 系统分区，300MB
              <CreatePartition wcm:action="add">
                <Order>2</Order>
                <Size>300</Size>
                <Type>EFI</Type>
              </CreatePartition>
              ; 分区 3：MSR 保留分区，16MB
              <CreatePartition wcm:action="add">
                <Order>3</Order>
                <Size>16</Size>
                <Type>MSR</Type>
              </CreatePartition>
              ; 分区 4：系统分区，吃掉剩余全部空间
              <CreatePartition wcm:action="add">
                <Order>4</Order>
                <Extend>true</Extend>
                <Type>Primary</Type>
              </CreatePartition>
            </CreatePartitions>
            <ModifyPartitions>
              ; TypeID 是微软官方的恢复分区 GUID，写错一个字符就会退化成普通数据盘
              <ModifyPartition wcm:action="add">
                <Order>1</Order>
                <PartitionID>1</PartitionID>
                <TypeID>de94bba4-06d1-4d40-a16a-bfd50179d6ac</TypeID>
                <Label>Recovery</Label>
                <Format>NTFS</Format>
              </ModifyPartition>
              <ModifyPartition wcm:action="add">
                <Order>2</Order>
                <PartitionID>2</PartitionID>
                <Label>System</Label>
                <Format>FAT32</Format>
              </ModifyPartition>
              <ModifyPartition wcm:action="add">
                <Order>3</Order>
                <PartitionID>4</PartitionID>
                <Label>Windows</Label>
                <Letter>C</Letter>
                <Format>NTFS</Format>
              </ModifyPartition>
            </ModifyPartitions>
            <DiskID>$$VT_WINDOWS_DISK_CLOSEST_200$$</DiskID>
            <WillWipeDisk>true</WillWipeDisk>
          </Disk>
          <WillShowUI>OnError</WillShowUI>
        </DiskConfiguration>
      -->

      <ImageInstall>
        <OSImage>
          <InstallFrom>
            <!--
              ★★★ 这里是整个部署最容易踩的坑，务必读完 ★★★

              线上 ISO：zh-cn_windows_11_consumer_editions_version_25h2_
                        updated_sep_2026_x64_dvd_cb71b7e8.iso
              （微软官方消费版多版本镜像）install.wim 里的真实版本列表：

                  索引 1 | Windows 11 Home                  EDITIONID=Core
                  索引 2 | Windows 11 Home Single Language
                  索引 3 | Windows 11 Education
                  索引 4 | Windows 11 Pro                   EDITIONID=Professional
                  索引 5 | Windows 11 Pro Education
                  索引 6 | Windows 11 Pro for Workstations

              ⚠️ 索引 1 是【家庭版】，不是专业版！
                 多版本 ISO 上写死 INDEX=1 会静默装成 Home，
                 而且和下面 ProductKey 里的专业版密钥互相矛盾。

              这里用【名字】而不是索引，两个原因：
                1. 名字写错会【大声失败】（Setup 报找不到映像），
                   索引写错只会【静默装错版本】——后者危险得多。
                2. 名字不随 ISO 里版本的排序变化而失效。

              ★ 换 ISO 时必须重新确认名字 ★
              在 Windows 上挂载 ISO 后执行：
                  dism /Get-WimInfo /WimFile:D:\sources\install.wim
              （install.wim 不存在就换成 install.esd）
              取输出的【名称 / Name】字段，原样填到下面的 Value。
              注意：要的是 Name，不是安装界面显示的 DISPLAYNAME。

              实测过的两套介质，名字差别很大，可见这一步不能想当然：
                  China Only 镜像 → NAME = "Windows 11 Pro China Only"
                  consumer 镜像   → NAME = "Windows 11 Pro"

              如果你想改用索引，consumer 镜像上专业版是 4：
                  <Key>/IMAGE/INDEX</Key><Value>4</Value>
            -->
            <MetaData wcm:action="add">
              <Key>/IMAGE/NAME</Key>
              <Value>Windows 11 Pro</Value>
            </MetaData>
          </InstallFrom>
          <InstallTo>
            <DiskID>$$VT_WINDOWS_DISK_CLOSEST_200$$</DiskID>
            <!-- 必须和上面创建的 OS 分区一致
                 （3 = 三分区简单布局，4 = 带独立 WinRE 分区的布局） -->
            <PartitionID>3</PartitionID>
          </InstallTo>
          <WillShowUI>OnError</WillShowUI>
        </OSImage>
      </ImageInstall>

      <UserData>
        <!--
          AcceptEula 必须保留：没有它，Windows Setup 会弹出许可条款页面，
          全自动流程就断了。文档规定的 UserData 子元素顺序是
          AcceptEula -> FullName -> Organization -> ProductKey，
          所以 AcceptEula 必须写在 ProductKey 前面。
        -->
        <AcceptEula>true</AcceptEula>

        <!--
          ProductKey 的作用（微软文档原文）：
          Microsoft-Windows-Setup\UserData\ProductKey\Key
          "Specifies the Windows image to install during Windows Setup"
          —— 它既决定"装哪个版本"，也是【唯一能跳过「产品密钥」页的元素】。
          （ImageInstall 里的 /IMAGE/NAME 只负责挑映像，管不到密钥页。）

          下面 VK7JG-NPHTM-C97JM-9MPGT-3V66T 是微软给 Windows 11 专业版用的
          通用安装密钥，属于公开信息、【不具备激活功能】。配 consumer 版官方镜像
          已实测能正常跳过密钥页。真正的激活仍靠数字许可证 / KMS / ADBA。

          ⚠️ 必须和上面 InstallFrom 的 /IMAGE/NAME 对上：
             这里选专业版，上面也必须是专业版，否则 Setup 会报错。

          ⚠️ 千万不要把真实的 MAK / 零售密钥写在这里 —— 本文件由 iVentoy
             通过明文 HTTP 提供，那才是真的会泄露。

          WillShowUI 取值 Always / OnError（默认）/ Never。
          这里用 OnError：密钥正常时不弹页面；万一被拒会弹出来让你看见，
          而不是静默失败。确认稳定后可以改成 Never。

          其他常用户籍的通用密钥（换版本时记得同时改上面的 /IMAGE/NAME）：
            Windows 11 Pro          W269N-WFGWX-YVC9B-4J6C9-T83GX
            Windows 11 Home         YTMG3-N6DKC-DKB77-7M9GH-8HVX7
            Windows 11 Enterprise   NPPR9-FWDCX-D2C8J-H872K-2YT43
            Windows 11 Education    NW6C2-QMPVW-D7KKK-3GKT6-VCFB2

          ⚠️ 记一笔历史教训：之前那张 China Only 镜像
             （EDITIONID=ProfessionalCountrySpecific）用不了任何通用密钥，
             那种镜像只能删掉本元素、靠主板固件里的 OEM 密钥。
        -->
        <ProductKey>
          <Key>VK7JG-NPHTM-C97JM-9MPGT-3V66T</Key>
          <WillShowUI>OnError</WillShowUI>
        </ProductKey>
      </UserData>
    </component>
  </settings>

  <!-- ======================= 阶段 2：specialize ======================== -->
  <settings pass="specialize">
    <component name="Microsoft-Windows-International-Core"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral"
               versionScope="nonSxS"
               xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
      <InputLocale>0804:00000804</InputLocale>
      <SystemLocale>zh-CN</SystemLocale>
      <UILanguage>zh-CN</UILanguage>
      <UserLocale>zh-CN</UserLocale>
    </component>

    <component name="Microsoft-Windows-Shell-Setup"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral"
               versionScope="nonSxS"
               xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
      <!--
        这里故意不设置 <ComputerName>，让 Windows 自己生成 DESKTOP-XXXXXXX 这样的随机名。

        为什么不写死一个固定名字：现阶段没有后置脚本，所有机器都会拿到同一个名字，
        在同一网段或同一个域里会直接冲突。

        也不用 iVentoy 的 MAC 变量来拼：Windows 计算机名最长 15 个字符，
        而带连字符的 MAC 本身就有 17 个字符，拼不出合法名字。

        想按序列号 / MAC 自动命名，需要一个后置脚本在首次登录时调用
        Rename-Computer 或 Add-Computer -NewName，见 README 的「已知缺口」一节。
      -->
      <!--
        RegisteredOwner / RegisteredOrganization 已按你的要求删除。
        它们只是"注册给谁"的展示性元数据（systeminfo、注册表、
        资产清点工具会读），不影响激活、授权、计算机名或加域。
        需要时加回来即可（有效阶段同样包含 specialize）：
          <RegisteredOrganization>公司名</RegisteredOrganization>
          <RegisteredOwner>IT 部</RegisteredOwner>
      -->
      <TimeZone>China Standard Time</TimeZone>
    </component>
  </settings>

  <!-- ====================== 阶段 3：oobeSystem ========================= -->
  <settings pass="oobeSystem">
    <component name="Microsoft-Windows-International-Core"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral"
               versionScope="nonSxS"
               xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
      <InputLocale>0804:00000804</InputLocale>
      <SystemLocale>zh-CN</SystemLocale>
      <UILanguage>zh-CN</UILanguage>
      <UserLocale>zh-CN</UserLocale>
    </component>

    <component name="Microsoft-Windows-Shell-Setup"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral"
               versionScope="nonSxS"
               xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

      <!--
        LogonCount 是自动登录的次数。这里保持 1：
        下面 FirstLogonCommands 只是下载并【弹出】驱动总裁的图形界面，
        由现场人员确认安装，脚本本身不重启系统，所以 1 次足够。

        微软文档要求用 AutoLogon 时【必须】指定 LogonCount，所以不能省略。

        如果以后改成"首次登录跑静默脚本、脚本结尾自动重启"的做法，
        必须把 LogonCount 调到 2 以上（通常 3），否则第二次开机会停在锁屏，
        后面的步骤永远不会执行。

        Username 必须是 Administrator：这是微软指定的启用内置 Administrator 的方式，
        见下面 UserAccounts 处的说明。
      -->
      <AutoLogon>
        <Password>
          <!-- EDIT ME：必须和下面 AdministratorPassword 的密码完全一致 -->
          <Value>root123</Value>
          <PlainText>true</PlainText>
        </Password>
        <Enabled>true</Enabled>
        <LogonCount>1</LogonCount>
        <Username>Administrator</Username>
      </AutoLogon>

      <!--
        首次登录时自动做的事：把驱动总裁拉下来并启动它，装完驱动。

        【为什么用 FirstLogonCommands，而不是 $OEM$\SetupComplete.cmd】
        微软文档对 SetupComplete.cmd 写了一句很关键的话：
            "This setting is disabled when using OEM product keys,
             except on Enterprise editions and Windows Server operating systems."
        也就是说 OEM 品牌机（固件里带密钥的那种）上它会被【直接跳过】。
        我们的目标机大概率正是这类机器，所以那条路不可靠。

        【权限没问题】本文件里 FirstLogonCommands 的有效阶段是 oobeSystem，
        文档另外说明：
            "When a user with administrative privileges logs in for the first
             time, these commands are run with elevated access privileges."
        我们用 Administrator 自动登录，天然满足。

        【子元素顺序】按文档：CommandLine -> Description -> Order -> RequiresUserInput。

        【两条命令的分工】
          第 1 条：从 iVentoy 服务器把小脚本拉下来（URL 里的 $$...$$ 由 iVentoy 展开）
          第 2 条：执行小脚本，并把安装包地址传给它
        小脚本会下载驱动总裁安装包并【弹出图形界面】，由现场人员确认，
        所以【不加 /S 静默参数】。

        【依赖】<iVentoy>\user\deploy\ 下必须同时有这两个文件：
                  install-drivers.cmd   本仓库提供，原样复制
                  DrvCeoSetup.exe       驱动总裁安装包，自行下载后改成这个名字
                详见 user/deploy/README.md

        【日志】客户机上 C:\Windows\Temp\install-drivers.log
                脚本会保留在 C:\Windows\Temp\install-drivers.cmd，现场可手动重跑。
      -->
      <FirstLogonCommands>
        <SynchronousCommand wcm:action="add">
          <CommandLine>cmd /c curl -sSL -o C:\Windows\Temp\install-drivers.cmd http://$$VT_SERVER_IP$$:$$VT_HTTP_PORT$$/user/deploy/install-drivers.cmd</CommandLine>
          <Description>从 iVentoy 服务器下载驱动安装脚本</Description>
          <Order>1</Order>
          <RequiresUserInput>false</RequiresUserInput>
        </SynchronousCommand>
        <SynchronousCommand wcm:action="add">
          <CommandLine>cmd /c C:\Windows\Temp\install-drivers.cmd http://$$VT_SERVER_IP$$:$$VT_HTTP_PORT$$/user/deploy/DrvCeoSetup.exe</CommandLine>
          <Description>下载并启动驱动总裁，由现场人员确认后安装</Description>
          <Order>2</Order>
          <RequiresUserInput>false</RequiresUserInput>
        </SynchronousCommand>
      </FirstLogonCommands>

      <OOBE>
        <HideEULAPage>true</HideEULAPage>
        <HideLocalAccountScreen>true</HideLocalAccountScreen>
        <HideOEMRegistrationScreen>true</HideOEMRegistrationScreen>
        <HideOnlineAccountScreens>true</HideOnlineAccountScreens>
        <HideWirelessSetupInOOBE>true</HideWirelessSetupInOOBE>
        <NetworkLocation>Work</NetworkLocation>
        <ProtectYourPC>3</ProtectYourPC>
      </OOBE>

      <!--
        直接用内置 Administrator，不再创建额外的本地账户。

        微软文档《AdministratorPassword》原文：
          "By default, the built-in administrator account is disabled in all
           default clean installations. You can enable the built-in
           administrator account during unattended installations, by setting
           the AutoLogon/Username to Administrator."
        也就是说：下面 AdministratorPassword 只负责设密码，
        【真正启用这个账户的是上面 AutoLogon 里的 Username=Administrator】。

        不要再用 Microsoft-Windows-Deployment 去跑
        "net user Administrator /active:yes"，那是多余动作；
        同文档还警告显式启用内置 Administrator 可能让设备无法正常进入 OOBE。

        另据《AutoLogon》文档：AutoLogon 会让 OOBE 跳过"创建用户"环节。
      -->
      <UserAccounts>
        <AdministratorPassword>
          <!-- EDIT ME：必须和上面 AutoLogon 的密码完全一致 -->
          <Value>root123</Value>
          <PlainText>true</PlainText>
        </AdministratorPassword>
      </UserAccounts>
    </component>
  </settings>
</unattend>
