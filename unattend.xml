<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  iVentoy unattended answer file for Windows 11  (UEFI / GPT)
  ============================================================================
  Place this file in:   <iVentoy>\user\scripts\unattend.xml
  Then in iVentoy UI  -> Image Management -> select the Win11 ISO
                      -> Auto Install Script: add this file, set it as default
                      -> set "Script Select Timeout" to a non-zero value

  iVentoy expands $$VT_xxx$$ variables inside auto-install scripts.
  Verified variables used here:
    $$VT_WINDOWS_DISK_CLOSEST_200$$  -> Windows disk number of the disk whose
                                        capacity is closest to 200 GB.
                                        Alternatives for the same slot:
                                          _1ST_NONUSB   first non-USB disk
                                          _MAX_SIZE     largest disk
                                          _CLOSEST_<n>  closest to n GB
    $$VT_SERVER_IP$$                -> iVentoy server IP
    $$VT_HTTP_PORT$$                -> iVentoy HTTP port (default 16000)
    $$VT_MAC_DASH_UPPER$$           -> PXE NIC MAC, e.g. 11-22-33-AA-BB-CC

  KEEP THIS FILE ASCII-ONLY. Non-ASCII characters plus a missing BOM is the
  classic cause of "Windows could not parse or process the unattend answer
  file". All Chinese documentation lives in README.md instead.

  THINGS YOU MUST EDIT BEFORE USE (search for "EDIT ME"):
    1. /IMAGE/NAME          -> exact edition name in your install.wim
                               (localised on non-English media - see the
                                LOCALISED MEDIA WARNING further down)
    2. Local admin password (2 places: AutoLogon + UserAccounts)
    3. RegisteredOwner / RegisteredOrganization

  WINDOWS 11 SPECIFICS - THESE ARE NOT HANDLED BY THIS FILE:
    * TPM 2.0 / Secure Boot / RAM / CPU requirement checks are bypassed by the
      iVentoy UI checkbox "ByPass HW Check" (it writes the
      HKLM\SYSTEM\Setup\LabConfig\Bypass*Check registry values in WinPE).
      Installing Windows 11 on ineligible hardware WITHOUT iVentoy, or with
      that checkbox unchecked, will stop at "This PC can't run Windows 11".
    * Skipping the Microsoft-account requirement is the "ByPass NRO" checkbox.
      This file does NOT depend on it: the local account below is created
      through the documented UserAccounts element, so the flow keeps working
      on builds where bypassnro is removed.
    * Windows 11 will not install to MBR/Legacy, hence the UEFI/GPT layout.
  ============================================================================
-->
<unattend xmlns="urn:schemas-microsoft-com:unattend">

  <!-- ======================= PASS 1: windowsPE ========================= -->
  <settings pass="windowsPE">

    <component name="Microsoft-Windows-International-Core-WinPE"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral"
               versionScope="nonSxS"
               xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
      <SetupUILanguage>
        <UILanguage>zh-CN</UILanguage>
      </SetupUILanguage>
      <InputLocale>0804:00000804</InputLocale>
      <SystemLocale>zh-CN</SystemLocale>
      <UILanguage>zh-CN</UILanguage>
      <UserLocale>zh-CN</UserLocale>
    </component>

    <!--
      No Microsoft-Windows-PnpCustomizationsWinPE component here, on purpose:
      this deployment relies on the NIC drivers already present in the ISO's
      boot.wim and does not use iVentoy file injection.

      IF a machine ever stops with "A media driver your computer needs is
      missing", that error is NOT a missing disk driver. It means boot.wim has
      no driver for that machine's NIC, so iVentoy cannot mount the ISO over
      the network and Setup cannot find its install source. The fix is to add
      this component back with <Path>X:\drivers</Path> and to ship the vendor
      NIC drivers through an iVentoy injection archive - see the
      "missing driver" section of README.md.
    -->

    <component name="Microsoft-Windows-Setup"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral"
               versionScope="nonSxS"
               xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
      <DiskConfiguration>
        <Disk wcm:action="add">
          <CreatePartitions>
            <CreatePartition wcm:action="add">
              <Order>1</Order>
              <Size>300</Size>
              <Type>EFI</Type>
            </CreatePartition>
            <CreatePartition wcm:action="add">
              <Order>2</Order>
              <Size>16</Size>
              <Type>MSR</Type>
            </CreatePartition>
            <CreatePartition wcm:action="add">
              <Order>3</Order>
              <Extend>true</Extend>
              <Type>Primary</Type>
            </CreatePartition>
          </CreatePartitions>
          <ModifyPartitions>
            <!-- Partition 1: EFI system partition, must be FAT32 -->
            <ModifyPartition wcm:action="add">
              <Order>1</Order>
              <PartitionID>1</PartitionID>
              <Label>System</Label>
              <Format>FAT32</Format>
            </ModifyPartition>
            <!--
              Partition 2 (MSR) is intentionally NOT modified/formatted.
              Adding it here is a common cause of a Setup failure.
              Partition 3 is the OS volume.
            -->
            <ModifyPartition wcm:action="add">
              <Order>2</Order>
              <PartitionID>3</PartitionID>
              <Label>Windows</Label>
              <Letter>C</Letter>
              <Format>NTFS</Format>
            </ModifyPartition>
          </ModifyPartitions>
          <!--
            *** DESTRUCTIVE ***
            Target disk = the one whose capacity is closest to 200 GB.

            Why not hardcode 0: on machines with several controllers the
            enumeration order is not what you expect, and you would wipe the
            wrong disk.

            Why closest-to-N instead of "first non-USB": it selects by a
            property that is stable across firmware and controller changes,
            so the same answer file works on a mixed fleet.

            WATCH OUT: _CLOSEST_ / _MAX_SIZE only rank by capacity. They do
            NOT exclude USB disks the way _1ST_NONUSB does. A large USB stick
            or USB SSD left plugged in can win the comparison and get wiped.
            Unplug all removable storage before imaging.

            The match is against the capacity Windows reports, which is GiB
            shown as "GB": a drive sold as 200 GB shows up as ~186 GB, one
            sold as 256 GB as ~238 GB. 200 still ranks them correctly
            (|186-200| = 14 beats |238-200| = 38).

            Confirm the real numbers on your first test machine - the injected
            VentoyAutoRun.bat already dumps "list disk" into X:\VentoyAutoRun.log,
            so you can read the exact GB value and set it here.
          -->
          <DiskID>$$VT_WINDOWS_DISK_CLOSEST_200$$</DiskID>
          <WillWipeDisk>true</WillWipeDisk>
        </Disk>
        <WillShowUI>OnError</WillShowUI>
      </DiskConfiguration>

      <!--
        OPTIONAL: dedicated 1 GB WinRE partition, GPT recovery type GUID.
        Windows 11 25H2/26H2 shrinks the recovery partition to ~500 MB and
        later cumulative updates then fail with 0x80070643. This layout creates
        it up front at 1000 MB. Note the ordering rule: the partition that uses
        <Extend>true</Extend> must be created LAST, which is why Recovery is
        partition 1 here, not partition 4.

        To use it, replace the whole <DiskConfiguration> block above with this
        one and change <InstallTo><PartitionID> below from 3 to 4.

        <DiskConfiguration>
          <Disk wcm:action="add">
            <CreatePartitions>
              <CreatePartition wcm:action="add">
                <Order>1</Order>
                <Size>1000</Size>
                <Type>Primary</Type>
              </CreatePartition>
              <CreatePartition wcm:action="add">
                <Order>2</Order>
                <Size>300</Size>
                <Type>EFI</Type>
              </CreatePartition>
              <CreatePartition wcm:action="add">
                <Order>3</Order>
                <Size>16</Size>
                <Type>MSR</Type>
              </CreatePartition>
              <CreatePartition wcm:action="add">
                <Order>4</Order>
                <Extend>true</Extend>
                <Type>Primary</Type>
              </CreatePartition>
            </CreatePartitions>
            <ModifyPartitions>
              <ModifyPartition wcm:action="add">
                <Order>1</Order>
                <PartitionID>1</PartitionID>
                <TypeID>de94bba4-06d1-4d40-a16a-bfd50179d6ac</TypeID>
                <Label>Recovery</Label>
                <Format>NTFS</Format>
              </ModifyPartition>
              <ModifyPartition wcm:action="add">
                <Order>2</Order>
                <PartitionID>2</PartitionID>
                <Label>System</Label>
                <Format>FAT32</Format>
              </ModifyPartition>
              <ModifyPartition wcm:action="add">
                <Order>3</Order>
                <PartitionID>4</PartitionID>
                <Label>Windows</Label>
                <Letter>C</Letter>
                <Format>NTFS</Format>
              </ModifyPartition>
            </ModifyPartitions>
            <DiskID>$$VT_WINDOWS_DISK_CLOSEST_200$$</DiskID>
            <WillWipeDisk>true</WillWipeDisk>
          </Disk>
          <WillShowUI>OnError</WillShowUI>
        </DiskConfiguration>
      -->

      <ImageInstall>
        <OSImage>
          <InstallFrom>
            <!--
              EDIT ME: exact edition name. List them on a running Windows with
                  dism /Get-WimInfo /WimFile:D:\sources\install.wim
              (use install.esd instead of install.wim for newer media)

              *** LOCALISED MEDIA WARNING ***
              On non-English Windows media the image Name is usually localised.
              A zh-CN ISO typically reports "Windows 11 Pro" as
              "Windows 11 Zhuan Ye Ban" in Chinese characters. You MUST copy the
              Name exactly as dism prints it.

              If that string contains non-ASCII characters, this file can no
              longer stay pure ASCII. Then do ONE of these:
                (a) re-save this file as UTF-8 *with* BOM, or
                (b) switch to /IMAGE/INDEX and keep the file ASCII:
                      <Key>/IMAGE/INDEX</Key><Value>5</Value>
                    (the index depends on the media, so pin the ISO you deploy)

              Using /IMAGE/NAME instead of /IMAGE/INDEX means re-releasing the
              ISO with the editions in a different order will not break you.
            -->
            <MetaData wcm:action="add">
              <Key>/IMAGE/NAME</Key>
              <Value>Windows 11 Pro</Value>
            </MetaData>
          </InstallFrom>
          <InstallTo>
            <DiskID>$$VT_WINDOWS_DISK_CLOSEST_200$$</DiskID>
            <!-- Must match the OS partition created above (3 = simple layout,
                 4 = layout with the dedicated WinRE partition) -->
            <PartitionID>3</PartitionID>
          </InstallTo>
          <WillShowUI>OnError</WillShowUI>
        </OSImage>
      </ImageInstall>

      <UserData>
        <AcceptEula>true</AcceptEula>
        <!-- EDIT ME -->
        <FullName>IT</FullName>
        <Organization>YourCompany</Organization>
        <!--
          No ProductKey on purpose: embedding one in a file that iVentoy serves
          over plain HTTP would leak it to the whole LAN.
          If you use KMS/ADBA activation, add a generic KMS client key here
          instead of a real MAK:
            <ProductKey>
              <Key>W269N-WFGWX-YVC9B-4J6C9-T83GX</Key>
              <WillShowUI>OnError</WillShowUI>
            </ProductKey>
        -->
      </UserData>
    </component>
  </settings>

  <!-- ======================= PASS 2: specialize ======================== -->
  <settings pass="specialize">
    <component name="Microsoft-Windows-International-Core"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral"
               versionScope="nonSxS"
               xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
      <InputLocale>0804:00000804</InputLocale>
      <SystemLocale>zh-CN</SystemLocale>
      <UILanguage>zh-CN</UILanguage>
      <UserLocale>zh-CN</UserLocale>
    </component>

    <component name="Microsoft-Windows-Shell-Setup"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral"
               versionScope="nonSxS"
               xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
      <!--
        Deliberately a throwaway name. The real name is derived from the
        service tag / MAC by deploy.ps1 at first logon, and applied together
        with the domain join (Add-Computer -NewName) so the AD object is
        created with the correct name from the start.

        Do NOT try to build the name here from $$VT_MAC_COLON_UPPER$$:
        a Windows computer name may not contain ':' and is limited to 15 chars.
      -->
      <ComputerName>PC-DEPLOYING</ComputerName>
      <!-- EDIT ME -->
      <RegisteredOrganization>YourCompany</RegisteredOrganization>
      <RegisteredOwner>IT</RegisteredOwner>
      <TimeZone>China Standard Time</TimeZone>
    </component>
  </settings>

  <!-- ====================== PASS 3: oobeSystem ========================= -->
  <settings pass="oobeSystem">
    <component name="Microsoft-Windows-International-Core"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral"
               versionScope="nonSxS"
               xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
      <InputLocale>0804:00000804</InputLocale>
      <SystemLocale>zh-CN</SystemLocale>
      <UILanguage>zh-CN</UILanguage>
      <UserLocale>zh-CN</UserLocale>
    </component>

    <component name="Microsoft-Windows-Shell-Setup"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral"
               versionScope="nonSxS"
               xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

      <!--
        LogonCount 3 (not the default 1) is required because deploy.ps1
        reboots the machine at the end of the run; without it the second boot
        would stop at the lock screen and the remaining steps would never run.
      -->
      <AutoLogon>
        <Password>
          <!-- EDIT ME (must match the LocalAccount password below) -->
          <Value>ChangeMe!2024</Value>
          <PlainText>true</PlainText>
        </Password>
        <Enabled>true</Enabled>
        <LogonCount>3</LogonCount>
        <Username>deploy</Username>
      </AutoLogon>

      <!--
        This is the bridge between Windows Setup and the iVentoy server.

        The answer file is static, but the machine-specific work (driver pack,
        software, serial-based rename, domain join) is not. iVentoy serves its
        own "user" directory over HTTP, so the script is pulled at first logon
        from:
            http://<iVentoy IP>:16000/user/deploy/deploy.ps1

        Lives in the answer file as a single line on purpose: FirstLogonCommands
        runs commands verbatim through cmd.exe, so no line continuation.
        '&' must be escaped as &amp; because this is XML.
      -->
      <FirstLogonCommands>
        <SynchronousCommand wcm:action="add">
          <Order>1</Order>
          <Description>iVentoy post-install deployment script</Description>
          <CommandLine>powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Continue'; $u='http://$$VT_SERVER_IP$$:$$VT_HTTP_PORT$$/user/deploy/deploy.ps1'; $o='C:\Windows\Temp\deploy.ps1'; try { Invoke-WebRequest -Uri $u -OutFile $o -UseBasicParsing } catch { $o=$null }; if ($o -and (Test-Path $o)) { &amp; $o -PxeMac '$$VT_MAC_DASH_UPPER$$' -ServerIp '$$VT_SERVER_IP$$' -ServerPort '$$VT_HTTP_PORT$$' } else { Add-Content 'C:\Windows\Temp\deploy.log' ('FAILED to download ' + $u) }"</CommandLine>
          <RequiresUserInput>false</RequiresUserInput>
        </SynchronousCommand>
      </FirstLogonCommands>

      <OOBE>
        <HideEULAPage>true</HideEULAPage>
        <HideLocalAccountScreen>true</HideLocalAccountScreen>
        <HideOEMRegistrationScreen>true</HideOEMRegistrationScreen>
        <HideOnlineAccountScreens>true</HideOnlineAccountScreens>
        <HideWirelessSetupInOOBE>true</HideWirelessSetupInOOBE>
        <NetworkLocation>Work</NetworkLocation>
        <ProtectYourPC>3</ProtectYourPC>
      </OOBE>

      <UserAccounts>
        <LocalAccounts>
          <LocalAccount wcm:action="add">
            <Password>
              <!-- EDIT ME (must match AutoLogon above) -->
              <Value>ChangeMe!2024</Value>
              <PlainText>true</PlainText>
            </Password>
            <Name>deploy</Name>
            <DisplayName>deploy</DisplayName>
            <Group>Administrators</Group>
          </LocalAccount>
        </LocalAccounts>
      </UserAccounts>
    </component>
  </settings>
</unattend>
